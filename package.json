{
  "name": "card-mod",
  "version": "2026.09.08.1",
  "description": "Add CSS styles to almost any Home Assistant dashboard element from card config or themes",
  "main": "dist/card-mod.js",
  "type": "module",
  "scripts": {
    "build": "npm run lint && npm run rollup",
    "rollup": "rollup -c",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "start": "rollup -c --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trooperthorn/ha_card-mod.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "hacs"
  ],
  "author": "Thomas Lovén",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/trooperthorn/ha_card-mod/issues"
  },
  "homepage": "https://github.com/trooperthorn/ha_card-mod#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "rollup": "^3.29.5",
    "typescript": "~5.6.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@watchable/unpromise": "^1.0.2",
    "js-yaml": "^5.4.1",
    "lit": "^3.3.0",
    "tslib": "^2.8.1"
  }
}
